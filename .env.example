# Portal build-time configuration (copy to .env, I1-6).
# Absent values keep the built-in demo behavior.

# 生产平台网关（§34/§81）。配置后 live 数据源切换为 WebSocket 传输。
VITE_GATEWAY_WS_URL=

# 远端 MapLibre style（不配置则使用内置离线暗色底图）。
VITE_MAP_STYLE_URL=

# 内置底图使用的 raster 瓦片模板（可选）。
VITE_RASTER_TILES_URL=

# 3D Tiles 全局缓存字节预算（默认 512MiB，§49）。
VITE_TILES_MAX_BYTES=

# 初始质量档位：OFFICE | STANDARD | HIGH | EXHIBITION（默认 STANDARD，§67）。
VITE_DEFAULT_QUALITY=

# 真实 3D Tiles tileset 入口（I4-3；经 TilesSystem 接入，诊断面板可见缓存/队列）。
VITE_TILES_TILESET_URL=

# KTX2/DRACO 解码器基础路径（I4-2；离线部署指向本地静态目录，
# 见 docs/asset-pipeline.md。缺省为随 three exact pin 的 CDN）。
VITE_ASSET_DECODER_PATH=
